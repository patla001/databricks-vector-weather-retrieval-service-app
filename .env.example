# Local development overrides. Copy to .env and fill in.
#
# On Databricks Apps these come from the platform instead: LAKEBASE_URL is
# injected by a secret *resource* (see the `valueFrom` entry in app.yaml), and
# everything else is plain configuration set in app.yaml's `env:` block.
#
# Do NOT commit a filled-in .env - the Lakebase URL contains the role password.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Standard Postgres connection URL for the Lakebase instance, pointing at a
# native Postgres role with a static (non-expiring) password.
LAKEBASE_URL=postgresql://<role>:<password>@<instance>.database.cloud.databricks.com:5432/databricks_postgres?sslmode=require

# ---------------------------------------------------------------------------
# Optional - fallback path when LAKEBASE_URL is not set
# ---------------------------------------------------------------------------
# The URL is read from this Databricks secret scope/key instead. This app uses
# its own key rather than the shared `database/lakebase-url` that the day-2
# ticker-news app reads, so the two can point at different databases.
# LAKEBASE_SECRET_SCOPE=database
# LAKEBASE_SECRET_KEY=weather-lakebase-url

# ---------------------------------------------------------------------------
# Optional - National Weather Service client
# ---------------------------------------------------------------------------
# NWS requires no API key, but it does require a User-Agent that identifies the
# caller with a contact address. Requests without one are throttled or refused.
# NWS_USER_AGENT=(databricks-vector-weather-retrieval-service-app, you@example.edu)
# NWS_API_BASE_URL=https://api.weather.gov

# Alert query scope: "state" fetches every active alert in the location's state
# (bigger corpus, coarser); "point" fetches only alerts covering the exact
# coordinate (precise, often empty on a calm day).
# WEATHER_ALERT_SCOPE=state

# Default locations used by POST /weather/sync when the body omits "locations".
# PIPE-separated, because each entry is itself "City, ST" and would otherwise
# split on its own comma. Each entry is a known "City, ST" or a "lat,lon" pair.
# WEATHER_LOCATIONS=Chicago, IL|Austin, TX|Houston, TX|Miami, FL|Denver, CO

# ---------------------------------------------------------------------------
# Optional - table names and embedding model
# ---------------------------------------------------------------------------
# WEATHER_DOCUMENTS_TABLE=weather_documents
# WEATHER_EMBEDDINGS_TABLE=weather_embeddings

# Must match the dimension of the `embedding` column in
# sql/02_setup_weather_embeddings.sql. all-MiniLM-L6-v2 -> VECTOR(384).
# WEATHER_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# fastembed downloads the ONNX export on first use; point it somewhere writable.
# FASTEMBED_CACHE_PATH=/tmp/.cache/fastembed

# ---------------------------------------------------------------------------
# Optional - RAG summary on GET /weather/search?summarize=true
# ---------------------------------------------------------------------------
# Without this the endpoint still returns results, just no "summary" field.
# ANTHROPIC_API_KEY=sk-ant-...
# WEATHER_SUMMARY_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Optional - Flask
# ---------------------------------------------------------------------------
# FLASK_RUN_HOST=0.0.0.0
# FLASK_RUN_PORT=8000
# FLASK_DEBUG=1
