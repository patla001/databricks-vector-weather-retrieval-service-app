# ---------------------------------------------------------------------------
# Secrets - never commit a filled-in environment file
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
env.dms
.envrc
.databrickscfg
.pgpass
*.pgpass

# Anything that looks like a captured connection string. The Lakebase DSN
# carries the role password inline, so a stray "connection url" dump is a
# credential leak.
*connection*url*
*.log

# Keys and certs
*.pem
*.key
*.crt
*.p12

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Model cache (fastembed downloads the ONNX export on first use)
.cache/

# Databricks CLI sync state - local bookkeeping for `databricks sync`,
# not source. Committing it makes every machine fight over the snapshot.
.databricks/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.DS_Store
.idea/
.vscode/
*.swp

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# web/ holds the Next.js source and has its own .gitignore for node_modules,
# .next/ and out/.
#
# static/ is deliberately NOT ignored. It is the built console, and it has to
# be committed: `databricks sync` respects this file, and a Databricks App runs
# a Python runtime with no Node, so there is nowhere to run `next build` on the
# far side of the sync. Committing the export is what makes the app one
# deployable artifact. Rebuild it with `cd web && npm run build`.
web/shot.mjs
